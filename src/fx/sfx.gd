	&"hit_wax", &"break_wax", &"hit_sawdust", &"break_sawdust",
	&"hit_marble", &"break_marble", &"hit_metal", &"break_metal",
	# stage 2a: the night loop and the menus
	&"dust", &"lantern", &"buy", &"deny", &"interact", &"alarm",
	&"ui_move", &"ui_confirm", &"ui_back",
	# stage 2c-1: marble bust and the T-Rex skeleton
	&"shard_fire", &"shard_break", &"bust_grind", &"trex_roar", &"trex_bellow",
	&"trex_step", &"trex_scrape", &"trex_impact", &"tail_whoosh", &"bone_hit",
	&"bone_rattle", &"bone_collapse", &"crystal_hit", &"crystal_pulse",
	&"crystal_shatter", &"rubble",
	# content: gatling, flare gun, raptor, portrait, upgrades
	&"gatling_crank", &"gatling_spin", &"gatling_rattle", &"gatling_stop",
	&"flare_fire", &"flare_burn", &"flare_blast", &"glass_break",
	&"chain_clank", &"chain_break", &"raptor_hiss", &"raptor_screech",
	&"portrait_creak", &"paint_spit", &"paint_splat", &"hit_canvas",
	&"break_canvas", &"heartbeat", &"ear_warn",
	# the night in the lobby: fuses, doors, the grate, the crystal, the clock
	&"fuse_take", &"fuse_insert", &"relay", &"gate_jam", &"gate_open",
	&"door_slam", &"witching_bell",
