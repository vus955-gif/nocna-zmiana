## Floor I sounds that loop (their .import sets loop_mode forward): Sfx.play
## would cut them after one pass, so they go on a player of their own.
const LOOPING: Array[StringName] = [&"gatling_spin", &"gatling_rattle", &"scarab_swarm", &"book_flock", &"centaur_gallop",
	&"orrery_gears"]

var _cache: Dictionary = {}
var _quitting: bool = false


func _ready() -> void:
	# Closing the window goes through quit_cleanly(), so no sound is still
	# playing when the engine shuts down (it would report leaked playbacks).
	get_tree().auto_accept_quit = false
	for sound in SOUNDS:
		_stream(sound)   # load now, not on first use mid-fight


func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		quit_cleanly.call_deferred()   # not while the notification is still propagating


## Silences every sound, lets the audio thread release them, then quits.
func quit_cleanly(exit_code: int = 0) -> void:
	_quitting = true
	quitting.emit()
	stop_all()
	await get_tree().create_timer(0.2, true, false, true).timeout
	get_tree().quit(exit_code)


## Non-positional sound (the guard's own weapon, UI); [param pitch]
## shifts it (a weapon's own voice, FeelProfile.sound_pitch).
func play(sound: StringName, volume_db: float = 0.0, pitch_jitter: float = 0.06, pitch: float = 1.0) -> void:
	var stream := _stream(sound)
	if stream == null or _quitting:
		return
	var player := AudioStreamPlayer.new()
	player.stream = stream
	player.bus = BUS
	player.volume_db = volume_db
	player.pitch_scale = pitch * (1.0 + randf_range(-pitch_jitter, pitch_jitter))
	_start(player, sound, stream)


## Positional sound (exhibits, impacts); [param pitch] shifts it (a chime
## in a tier's own note).
func play_at(sound: StringName, position: Vector3, volume_db: float = 0.0, pitch_jitter: float = 0.1, pitch: float = 1.0) -> void:
	var stream := _stream(sound)
	if stream == null or _quitting or not _audible(position):
		return
	var player := AudioStreamPlayer3D.new()
	player.stream = stream
	player.bus = BUS
	player.volume_db = volume_db
	player.max_db = 0.0
	player.unit_size = 8.0
	player.max_distance = MAX_DISTANCE
	player.pitch_scale = pitch * (1.0 + randf_range(-pitch_jitter, pitch_jitter))
	player.position = position
	_start(player, sound, stream)


## The preloaded stream of [param sound] (null when it has no file): for
## sounds a node plays on a player of its own, such as the LOOPING ones.
func stream_of(sound: StringName) -> AudioStream:
	return _stream(sound)


## Menu sound on the UI bus; plays even while the game is paused.
func play_ui(sound: StringName, volume_db: float = 0.0) -> void:
	var stream := _stream(sound)
	if stream == null or _quitting:
		return
	var player := AudioStreamPlayer.new()
	player.stream = stream
	player.bus = UI_BUS
	player.volume_db = volume_db
	player.process_mode = Node.PROCESS_MODE_ALWAYS
	player.set_meta(&"ui", true)
	_start(player, sound, stream)


## Stops and removes every sound (clean shutdown: the audio server must not
## hold playbacks when the game quits).
func stop_all() -> void:
	for child in get_children():
		_release(child)


## Stops the game's sounds but lets menu sounds finish (scene swaps).
func stop_gameplay() -> void:
	for child in get_children():
		if not child.get_meta(&"ui", false):
			_release(child)


func _stream(sound: StringName) -> AudioStream:
	if not _cache.has(sound):
		var path := DIR + String(sound) + ".wav"
		_cache[sound] = load(path) if ResourceLoader.exists(path) else null
	return _cache[sound]


func _audible(position: Vector3) -> bool:
	var camera := get_viewport().get_camera_3d()
	return camera == null or camera.global_position.distance_to(position) <= MAX_DISTANCE


func _start(player: Node, sound: StringName, stream: AudioStream) -> void:
	_make_room(sound)
	player.set_meta(&"sound", sound)
	add_child(player)
	player.call(&"play")
	# a paused game sound must not be cut: its timer waits during the pause
	var always := player.process_mode == Node.PROCESS_MODE_ALWAYS
	get_tree().create_timer(stream.get_length() + 0.25, always, false, true).timeout.connect(player.queue_free)


## Frees a voice for [param sound]: the oldest copy of that sound when it
## already has MAX_COPIES, otherwise the oldest voice when the pool is full.
func _make_room(sound: StringName) -> void:
	var voices: Array[Node] = []
	var copies: Array[Node] = []
	for child in get_children():
		if child.is_queued_for_deletion():
			continue
		voices.append(child)
		if child.get_meta(&"sound", &"") == sound:
			copies.append(child)
	if copies.size() >= max_copies(sound):
		_release(copies[0])
	elif voices.size() >= MAX_VOICES:
		_release(voices[0])


## How many copies of [param sound] may play at once.
static func max_copies(sound: StringName) -> int:
	return COPIES.get(sound, MAX_COPIES)


func _release(voice: Node) -> void:
	if voice.has_method(&"stop"):
		voice.call(&"stop")
	remove_child(voice)
	voice.queue_free()
