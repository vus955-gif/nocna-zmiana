extends Node
## Sound service (autoload "Sfx"). Plays res://assets/sfx/<name>.wav
## (generated by tools/sfx/gen_sfx.py) on the SFX bus; the Master bus has a
## limiter (res://default_bus_layout.tres). Missing files are skipped
## silently, so gameplay never depends on audio. When the voice pool is
## full, the oldest voice makes room, so the newest sound always plays.
## Game sounds pause with the game (their clean-up timers too) and
## stop_gameplay() silences them when a scene or a night is swapped; menu
## sounds go through play_ui() on the UI bus and play on while paused.

## The game begins to quit: other audio (Music, Ambience) stops with it.
signal quitting

const DIR := "res://assets/sfx/"
const BUS := &"SFX"
const UI_BUS := &"UI"
const MAX_VOICES := 32
## Concurrent copies of one sound; the oldest copy makes room.
const MAX_COPIES := 3
## Sounds allowed more copies than that: a pack of four raptors hisses
## together.
const COPIES := {&"raptor_hiss": 4, &"hwacha_fire": 6, &"hwacha_pop": 6}
## Positional sounds farther than this from the camera are not played.
const MAX_DISTANCE := 60.0
## Every sound the game asks for; gen_sfx.py must produce all of them.
const SOUNDS: Array[StringName] = [
	&"pistol", &"shotgun", &"taser", &"punch", &"punch_hit", &"reload",
	&"empty", &"swing", &"hurt", &"dash", &"notice", &"growl",
