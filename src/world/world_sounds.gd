class_name WorldSounds
## Sounds of the lobby's world content: secrets, notes, the locker key,
## artifacts and the CCTV. Generated by tools/sfx/gen_sfx.py and played
## through the Sfx autoload (buses, voice pool and pausing come from there).
## Sfx.SOUNDS preloads the shared sounds; warm() loads these up front, so
## the first secret of a night does not hitch on a file read.

const NAMES: Array[StringName] = [
	&"secret", &"paper", &"wall_slide", &"grille", &"padlock",
	&"artifact", &"keys", &"cctv_switch", &"drawer", &"locker",
]
const PATH := "res://assets/sfx/%s.wav"

## Keeps the streams referenced (and so in the resource cache).
static var _warm: Array[AudioStream] = []


## Loads every world sound once.
static func warm() -> void:
	if not _warm.is_empty():
		return
	for sound in NAMES:
		var path := PATH % sound
		if ResourceLoader.exists(path):
			_warm.append(load(path) as AudioStream)


## Non-positional (what the guard does with his own hands).
static func cue(sound: StringName, volume_db: float = 0.0) -> void:
	Sfx.play(sound, volume_db, 0.03)


## Positional (a wall sliding away, a padlock shot off).
static func cue_at(sound: StringName, position: Vector3, volume_db: float = 0.0) -> void:
	Sfx.play_at(sound, position, volume_db, 0.04)


## On the UI bus, heard while the game is paused (the note reader).
static func ui(sound: StringName, volume_db: float = 0.0) -> void:
	Sfx.play_ui(sound, volume_db)
